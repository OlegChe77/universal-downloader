{
  "manifest_version": 3,
  "name": "Универсальный скачиватель",
  "short_name": "Скачиватель",
  "version": "1.2.1",
  "description": "Кнопка и пункт меню «Скачать в программе»: открывает «Универсальный скачиватель» с текущей ссылкой.",
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "action": {
    "default_title": "Скачать в программе",
    "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}
  },
  "background": {"service_worker": "background.js", "scripts": ["config.js", "background.js"]},
  "permissions": ["contextMenus", "activeTab"],
  "host_permissions": ["http://127.0.0.1/*"],
  "browser_specific_settings": {
    "gecko": {"id": "downloader@udl.local", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}
  }
}
